{
  "name": "endowstellar",
  "version": "0.1.0",
  "private": true,
  "description": "Onchain Donor-Advised Funds (DAF) and Philanthropy Platform on Stellar & Soroban",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "contract:build": "cargo build --manifest-path contracts/Cargo.toml --target wasm32-unknown-unknown --release",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml"
  },
  "keywords": [
    "stellar",
    "soroban",
    "daf",
    "donor-advised-funds",
    "philanthropy",
    "giving",
    "web3"
  ],
  "author": "EndowStellar Team",
  "license": "MIT"
}
